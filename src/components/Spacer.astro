---
import Row from "./Row.astro";
import SeasonScene from "./SeasonScene.astro";
---

<Row>
  <div class="spacer hatch" aria-hidden="true">
    <SeasonScene />
  </div>
</Row>

<style>
  .spacer {
    --spacer-h: clamp(32px, 5vw, 56px);
    position: relative;
    height: var(--spacer-h);
  }
</style>
