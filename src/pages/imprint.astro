---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import PageHead from "../components/PageHead.astro";
import LegalText from "../components/LegalText.astro";
import Spacer from "../components/Spacer.astro";
import Footer from "../components/Footer.astro";
import { profile, imprint } from "../data/profile";

const fullName = `${profile.name.first} ${profile.name.last}`;
---

<Base title={`${imprint.title} — ${fullName}`} description={`${imprint.title} — ${fullName}.`}>
  <Header />

  <main>
    <PageHead kicker={imprint.kicker} title={imprint.title} back="/" note={imprint.note} />
    <Spacer />
    <LegalText sections={imprint.sections} />
    <Spacer />
  </main>

  <Footer />
</Base>
