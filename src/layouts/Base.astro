---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Seasons from "../components/Seasons.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // Enable motion before first paint so revealed rows don't flash.
      // If the reveal script never runs, show everything after 2.5s.
      (function () {
        var root = document.documentElement;
        if (!window.matchMedia("(prefers-reduced-motion: no-preference)").matches) return;
        if (!("IntersectionObserver" in window)) return;
        root.classList.add("motion");
        setTimeout(function () {
          if (!("revealReady" in root.dataset)) root.classList.remove("motion");
        }, 2500);
      })();
      // Arrived via an internal link: resume the header progress line where the
      // previous page left it (see scripts/progress.ts).
      (function () {
        var start;
        try {
          start = Number(sessionStorage.getItem("nav-start"));
          sessionStorage.removeItem("nav-start");
        } catch (e) {}
        var elapsed = Date.now() - start;
        if (!(elapsed >= 0 && elapsed < 10000)) return;
        if (!window.matchMedia("(prefers-reduced-motion: no-preference)").matches) return;
        var root = document.documentElement;
        root.style.setProperty("--nav-elapsed", elapsed + "ms");
        root.classList.add("nav-loading");
      })();
      // Seasonal decorations (see scripts/season.ts), off unless the visitor opted in.
      // Meteorological season from the date (northern hemisphere) unless the dev
      // switcher overrides it.
      (function () {
        var root = document.documentElement;
        var season = ["winter", "spring", "summer", "autumn"][Math.floor(((new Date().getMonth() + 1) % 12) / 3)];
        try {
          var override = localStorage.getItem("season-override");
          if (/^(spring|summer|autumn|winter)$/.test(override)) season = override;
          if (localStorage.getItem("seasonal") === "on") root.dataset.seasonal = "on";
        } catch (e) {}
        root.dataset.season = season;
        root.style.setProperty("--season-t", (Date.now() % 3600000) + "ms");
      })();
    </script>
  </head>
  <body id="top">
    <Seasons />
    <slot />
    <script>
      import "../scripts/reveal";
      import "../scripts/progress";
      import "../scripts/season";
    </script>
  </body>
</html>
