---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import PageHead from "../components/PageHead.astro";
import LegalText from "../components/LegalText.astro";
import Spacer from "../components/Spacer.astro";
import Footer from "../components/Footer.astro";
import { profile, privacy } from "../data/profile";

const fullName = `${profile.name.first} ${profile.name.last}`;
---

<Base title={`${privacy.title} — ${fullName}`} description={`${privacy.title} — ${fullName}.`}>
  <Header />

  <main>
    <PageHead kicker={privacy.kicker} title={privacy.title} back="/" note={privacy.note} />
    <Spacer />
    <LegalText sections={privacy.sections} />
    <Spacer />
  </main>

  <Footer />
</Base>
