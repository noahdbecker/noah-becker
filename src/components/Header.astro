---
import Row from "./Row.astro";
import { profile } from "../data/profile";

// Links point at landing-page sections; `page` marks the matching subpage as current.
const nav = [
  { href: "/#profile", label: "Profile" },
  { href: "/#work", label: "Work", page: "/work" },
  { href: "/#university", label: "University" },
  { href: "/#photos", label: "Photos", page: "/photos" },
];
const path = Astro.url.pathname.replace(/\/$/, "");
---

<header class="header">
  <Row markers={false} reveal={false}>
    <nav class="bar cells" aria-label="Main">
      <a class="logo mono" href="/" aria-label={`${profile.name.first} ${profile.name.last} — home`}>
        {profile.name.first[0]}{profile.name.last[0]}
      </a>
      {
        nav.map((item) => (
          <a class="link label" href={item.href} aria-current={item.page === path ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <div class="fill hatch" aria-hidden="true"></div>
      <a class="cta label" href={profile.links.email}>Contact <span class="arrow" aria-hidden="true">→</span></a>
    </nav>
  </Row>
  <div class="nav-progress" aria-hidden="true"></div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    view-transition-name: site-header;
  }

  .bar {
    grid-template-columns: var(--header-h) repeat(4, auto) minmax(0, 1fr) auto;
    height: var(--header-h);
  }

  .bar > * {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo {
    background: var(--fg);
    color: var(--bg);
    font-weight: 700;
    font-size: 15px;
  }

  .link,
  .cta {
    padding-inline: 20px;
    transition: background-color 120ms, color 120ms;
  }

  .link:hover {
    background: var(--surface);
    color: var(--fg);
  }

  .link[aria-current="page"] {
    color: var(--fg);
    box-shadow: inset 0 -2px 0 var(--fg);
  }

  .cta {
    gap: 8px;
    background: var(--accent);
    color: var(--accent-fg);
  }

  .cta:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .arrow {
    transition: transform 120ms;
  }

  .cta:hover .arrow {
    transform: translateX(3px);
  }

  /* Page-change progress: an accent line laid over the header's bottom hairline.
     Driven by html.nav-loading / html.nav-done (scripts/progress.ts). */
  .nav-progress {
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }

  :global(.nav-loading) .nav-progress {
    animation: nav-load 8s calc(-1 * var(--nav-elapsed, 0ms)) both;
  }

  :global(.nav-done) .nav-progress {
    animation: nav-done 600ms var(--ease-out) both;
  }

  @keyframes nav-load {
    0% {
      transform: scaleX(0);
      animation-timing-function: var(--ease-out);
    }
    4% {
      transform: scaleX(0.3);
      animation-timing-function: var(--ease-out);
    }
    20% {
      transform: scaleX(0.6);
      animation-timing-function: var(--ease-out);
    }
    100% {
      transform: scaleX(0.9);
    }
  }

  @keyframes nav-done {
    from {
      transform: scaleX(var(--nav-from, 0));
    }
    45% {
      transform: scaleX(1);
      opacity: 1;
    }
    to {
      transform: scaleX(1);
      opacity: 0;
    }
  }

  @media (max-width: 720px) {
    .bar {
      grid-template-columns: var(--header-h) minmax(0, 1fr) auto;
    }
    .link {
      display: none !important;
    }
  }
</style>
