---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Skills from "../components/Skills.astro";
import Spacer from "../components/Spacer.astro";
import SectionHead from "../components/SectionHead.astro";
import Row from "../components/Row.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Strip from "../components/Strip.astro";
import StripControls from "../components/StripControls.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import MoreLink from "../components/MoreLink.astro";
import Footer from "../components/Footer.astro";
import {
  profile,
  skills,
  technologies,
  workProjects,
  uniProjects,
} from "../data/profile";

const fullName = `${profile.name.first} ${profile.name.last}`;
const pad = (n: number) => String(n).padStart(2, "0");
---

<Base
  title={`${fullName} — Vita`}
  description={`${fullName}: ${profile.current.role}. Profile, projects and more.`}
>
  <Header />

  <main>
    <section id="profile" aria-labelledby="profile-title">
      <Hero />
      <Spacer />
      <Skills title="Programming languages" id="skills-title" items={skills} />
      <Skills title="Technologies" id="tech-title" items={technologies} flip />
    </section>

    <Spacer />

    <section id="work" aria-labelledby="work-title">
      <SectionHead
        index="02"
        id="work-title"
        title="Work"
        note="Selected projects from my professional work."
      />
      <Row>
        <div class="grid-2 cells">
          {
            workProjects
              .slice(0, 2)
              .map((p, i) => (
                <ProjectCard
                  project={p}
                  code={`W/${pad(i + 1)}`}
                  href={`/work#${p.slug}`}
                />
              ))
          }
        </div>
      </Row>
      <MoreLink href="/work" label="Projects in depth" note="Case studies" />
    </section>

    <Spacer />

    <section id="university" aria-labelledby="university-title">
      <SectionHead
        index="03"
        id="university-title"
        title="University"
        note="Projects from my studies."
      >
        <StripControls
          slot="actions"
          target="uni-strip"
          label="university projects"
        />
      </SectionHead>
      <Strip
        id="uni-strip"
        label="University projects"
        count={uniProjects.length}
      >
        {
          uniProjects.map((p, i) => (
            <ProjectCard project={p} code={`U/${pad(i + 1)}`} size="sm" />
          ))
        }
      </Strip>
    </section>

    <Spacer />

    <section id="photos" aria-labelledby="photos-title">
      <SectionHead
        index="04"
        id="photos-title"
        title="Photos"
        note="A few moments away from the keyboard."
      />
      <PhotoGrid />
      <MoreLink href="/photos" label="See all photos" />
    </section>

    <Spacer />
  </main>

  <Footer />
</Base>

<style>
  .grid-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 720px) {
    .grid-2 {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
