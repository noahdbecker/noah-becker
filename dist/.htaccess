# Apache (Plesk): send /work to /work/ so typed or old links without the

# trailing slash still reach work/index.html. See docs/decisions.md

DirectorySlash On
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>
