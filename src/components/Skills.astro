---
import Row from "./Row.astro";
import { skills } from "../data/profile";

const levelNames = ["", "Basics", "Working", "Solid", "Advanced", "Expert"];
---

<Row>
  <div class="skills cells">
    <div class="intro">
      <h2 class="label" id="skills-title">Programming languages</h2>
    </div>

    {
      skills.map((skill) => (
        <div class="skill">
          <div class="top">
            <h3>{skill.name}</h3>
            <span class="label">{skill.note ?? levelNames[skill.level]}</span>
          </div>
          <div class="meter" role="img" aria-label={`${levelNames[skill.level]}: ${skill.level} of 5`}>
            {Array.from({ length: 5 }, (_, i) => (
              <span class:list={{ on: i < skill.level }} style={`--b: ${i}`} />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Row>

<style>
  .skills {
    grid-template-columns: minmax(0, 1fr) repeat(3, minmax(0, 1fr));
  }

  .intro {
    grid-row: span 2;
    padding: var(--pad);
  }

  .skill {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: var(--pad);
    transition: background-color 120ms;
  }

  .skill:hover {
    background: var(--surface);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
  }

  h3 {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .meter {
    display: flex;
    gap: 4px;
    margin-top: auto;
  }

  .meter span {
    flex: 1;
    height: 10px;
    border: 1px solid var(--line);
  }

  .meter span.on {
    background: var(--fg);
    border-color: var(--fg);
  }

  /* While the row reveals, filled blocks light up one by one. */
  :global(.motion .frame[data-reveal]) .meter span.on {
    background: transparent;
    border-color: var(--line);
    transition:
      background-color 200ms,
      border-color 200ms;
    transition-delay: calc(var(--i, 0) * 70ms + 300ms + var(--b) * 80ms);
  }

  :global(.motion .frame.is-in) .meter span.on {
    background: var(--fg);
    border-color: var(--fg);
  }

  @media (max-width: 860px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .intro {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
</style>
