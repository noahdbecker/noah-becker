---
import Row from "./Row.astro";
import SeasonSwitcher from "./SeasonSwitcher.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import { profile } from "../data/profile";

const year = new Date().getFullYear();
const links = [
  { href: profile.links.email, label: "Email" },
  { href: profile.links.github, label: "GitHub" },
  { href: profile.links.linkedin, label: "LinkedIn" },
];
// Legally required in Germany (Impressum, Datenschutzerklärung): linked from every page.
const legal = [
  { href: "/imprint", label: "Imprint" },
  { href: "/privacy", label: "Privacy" },
];
---

<footer>
  <Row>
    <div class="foot cells">
      <p class="copy label">© {year} {profile.name.first} {profile.name.last}</p>
      {links.map((link) => <a class="link label" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}
      {legal.map((link) => <a class="link label" href={link.href}>{link.label} <span aria-hidden="true">→</span></a>)}
      <a class="top label" href="#top">Top <span aria-hidden="true">↑</span></a>
    </div>
  </Row>
  {import.meta.env.DEV && <SeasonSwitcher />}
  {import.meta.env.DEV && <ThemeSwitcher />}
  <Row>
    <div class="tail hatch" aria-hidden="true"></div>
  </Row>
</footer>

<style>
  .foot {
    grid-template-columns: minmax(0, 1fr) repeat(5, auto) auto;
  }

  .foot > * {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 64px;
    padding-inline: var(--pad);
  }

  .link,
  .top {
    transition: background-color 120ms, color 120ms;
  }

  .link:hover,
  .top:hover {
    background: var(--surface);
    color: var(--fg);
  }

  .tail {
    height: 96px;
  }

  @media (max-width: 860px) {
    .foot {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .copy {
      grid-column: 1 / -1;
    }
  }
</style>
