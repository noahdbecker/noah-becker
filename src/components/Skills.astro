---
import Row from "./Row.astro";
import type { Skill } from "../data/profile";

interface Props {
  title: string;
  id: string;
  items: Skill[];
  /** Put the label cell on the right instead of the left (desktop only). */
  flip?: boolean;
}

const { title, id, items, flip = false } = Astro.props;
---

<Row>
  <div class:list={["skills cells", { flip }]}>
    <div class="intro">
      <h2 class="label" id={id}>{title}</h2>
    </div>

    {
      items.map(({ name, logo: Logo }) => (
        <div class="skill">
          <Logo class="logo" fill="currentColor" aria-hidden="true" />
          <h3 class="label">{name}</h3>
        </div>
      ))
    }
  </div>
</Row>

<style>
  .skills {
    grid-template-columns: minmax(0, 1.5fr) repeat(6, minmax(0, 1fr));
  }

  .intro {
    padding: var(--pad);
  }

  .flip {
    grid-template-columns: repeat(6, minmax(0, 1fr)) minmax(0, 1.5fr);
  }

  /* Label stays first in the DOM (heading before its items), only moves visually. */
  .flip .intro {
    order: 1;
    text-align: right;
  }

  .skill {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: var(--pad) 8px;
    transition: background-color 120ms;
  }

  .skill:hover {
    background: var(--surface);
  }

  .logo {
    width: 36px;
    height: 36px;
    color: var(--fg);
  }

  h3 {
    text-align: center;
  }

  @media (max-width: 860px) {
    .skills {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .intro {
      grid-column: 1 / -1;
    }
    .flip .intro {
      order: 0;
      text-align: left;
    }
  }
</style>
