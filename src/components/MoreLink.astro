---
/** Row under a section: hatched filler, optional note, "see more" button. */
import Row from "./Row.astro";

interface Props {
  href: string;
  label: string;
  note?: string;
}

const { href, label, note } = Astro.props;
---

<Row>
  <div class="more cells">
    <div class="fill hatch" aria-hidden="true"></div>
    {note && <p class="note label">{note}</p>}
    <a class="btn" href={href}>
      <span>{label}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</Row>

<style>
  .more {
    grid-template-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    grid-auto-columns: auto;
  }

  .more > * {
    display: flex;
    align-items: center;
    min-height: 56px;
  }

  .note {
    padding-inline: var(--pad);
  }

  .btn {
    gap: 16px;
    padding-inline: var(--pad);
    background: var(--fg);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 120ms, color 120ms;
  }

  .btn:hover {
    background: var(--accent);
    color: var(--accent-fg);
  }

  .arrow {
    transition: transform 120ms;
  }

  .btn:hover .arrow {
    transform: translateX(3px);
  }
</style>
