---
import { Image } from "astro:assets";
import Row from "./Row.astro";
import { albumCovers } from "../data/profile";
---

<Row>
  <div class="photos cells">
    {
      albumCovers.map((photo, i) => (
        <figure class:list={["photo", { hatch: !photo.image }]}>
          {photo.image ? (
            <Image src={photo.image} alt={photo.alt} widths={[400, 800, 1200]} sizes="(max-width: 1232px) 50vw, 600px" />
          ) : (
            <span class="empty mono" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
          )}
          <figcaption class="label">{photo.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</Row>

<style>
  .photos {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .photo {
    position: relative;
    display: grid;
    place-items: center;
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .photo:hover :global(img) {
    transform: scale(1.03);
  }

  .photo.hatch:hover {
    background-position: 10px 0;
  }

  .empty {
    font-size: clamp(32px, 6vw, 72px);
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--line);
  }

  figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 6px 10px;
    border-top: 1px solid var(--line);
    border-right: 1px solid var(--line);
    background: var(--bg);
  }
</style>
