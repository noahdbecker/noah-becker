---
import Row from "./Row.astro";
import { skills } from "../data/profile";
---

<Row>
  <div class="skills cells">
    <div class="intro">
      <h2 class="label" id="skills-title">Programming languages</h2>
    </div>

    {
      skills.map(({ name, logo: Logo }) => (
        <div class="skill">
          <Logo class="logo" fill="currentColor" aria-hidden="true" />
          <h3 class="label">{name}</h3>
        </div>
      ))
    }
  </div>
</Row>

<style>
  .skills {
    grid-template-columns: minmax(0, 1.5fr) repeat(6, minmax(0, 1fr));
  }

  .intro {
    padding: var(--pad);
  }

  .skill {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: var(--pad) 8px;
    transition: background-color 120ms;
  }

  .skill:hover {
    background: var(--surface);
  }

  .logo {
    width: 36px;
    height: 36px;
    color: var(--fg);
  }

  h3 {
    text-align: center;
  }

  @media (max-width: 860px) {
    .skills {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .intro {
      grid-column: 1 / -1;
    }
  }
</style>
