---
/**
 * Image area for projects: the image if there is one, otherwise a dot grid
 * with a centred code badge. Always shows the code as a corner tag.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** Short code, e.g. "W/01". */
  code: string;
  image?: ImageMetadata;
  alt?: string;
  /** CSS aspect-ratio, e.g. "16 / 9". */
  ratio?: string;
  sizes?: string;
}

const { code, image, alt = "", ratio = "16 / 9", sizes = "(max-width: 860px) 100vw, 800px" } = Astro.props;
---

<div class="visual dots" style={`aspect-ratio: ${ratio}`}>
  {
    image ? (
      <Image src={image} alt={alt} widths={[480, 800, 1200]} sizes={sizes} />
    ) : (
      <span class="code mono" aria-hidden="true">{code}</span>
    )
  }
  <span class="corner label" aria-hidden="true">{code}</span>
</div>

<style>
  .visual {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .visual :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .code {
    padding: 10px 16px;
    border: 1px solid var(--line);
    background: var(--bg);
    font-size: clamp(18px, 3vw, 36px);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .corner {
    position: absolute;
    top: 0;
    left: 0;
    padding: 6px 10px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
</style>
