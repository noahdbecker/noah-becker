---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import PageHead from "../components/PageHead.astro";
import Album from "../components/Album.astro";
import Spacer from "../components/Spacer.astro";
import Footer from "../components/Footer.astro";
import { profile, albums } from "../data/profile";

const fullName = `${profile.name.first} ${profile.name.last}`;
const pad = (n: number) => String(n).padStart(2, "0");
---

<Base title={`Photos — ${fullName}`} description={`Photos by ${fullName}.`}>
  <Header />

  <main>
    <PageHead
      kicker="04 — Photos"
      title="Photos"
      back="/#photos"
      note="A few more moments away from the keyboard."
    />

    <Spacer />

    {
      albums.map((album, i) => (
        <>
          <Album album={album} code={`A/${pad(i + 1)}`} flip={i % 2 === 1} />
          <Spacer />
        </>
      ))
    }
  </main>

  <Footer />
</Base>
